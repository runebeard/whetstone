{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:whetstone:content-pack:v1",
  "title": "Whetstone Content Pack v1",
  "type": "object",
  "required": ["format", "schemaVersion", "pack"],
  "properties": {
    "$schema": { "type": "string" },
    "format": { "const": "whetstone-content-pack" },
    "schemaVersion": { "const": 1 },
    "pack": { "$ref": "#/$defs/pack" }
  },
  "additionalProperties": false,
  "$defs": {
    "nullableInteger": { "type": ["integer", "null"] },
    "nullableString": { "type": ["string", "null"] },
    "pack": {
      "type": "object",
      "required": ["id", "name", "gameSystem", "version", "author", "description", "weapons", "spells", "resources", "features", "items"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "gameSystem": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "author": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "weapons": { "type": "array", "items": { "$ref": "#/$defs/weapon" } },
        "spells": { "type": "array", "items": { "$ref": "#/$defs/spell" } },
        "resources": { "type": "array", "items": { "$ref": "#/$defs/resource" } },
        "features": { "type": "array", "items": { "$ref": "#/$defs/feature" } },
        "items": { "type": "array", "items": { "$ref": "#/$defs/item" } }
      },
      "additionalProperties": false,
      "anyOf": [
        { "properties": { "weapons": { "minItems": 1 } } },
        { "properties": { "spells": { "minItems": 1 } } },
        { "properties": { "resources": { "minItems": 1 } } },
        { "properties": { "features": { "minItems": 1 } } },
        { "properties": { "items": { "minItems": 1 } } }
      ]
    },
    "weapon": {
      "type": "object",
      "required": ["id", "name", "attackModifier", "damage"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "attackModifier": { "type": "integer" },
        "damage": { "type": "string", "minLength": 1 },
        "damageFormula": { "$ref": "#/$defs/nullableString" },
        "damageType": { "$ref": "#/$defs/nullableString" },
        "range": { "$ref": "#/$defs/nullableString" }
      },
      "additionalProperties": false
    },
    "spell": {
      "type": "object",
      "required": ["id", "name", "level", "prepared", "summary"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "level": { "type": "integer", "minimum": 0 },
        "prepared": { "type": "boolean" },
        "summary": { "type": "string", "minLength": 1 },
        "rollModifier": { "$ref": "#/$defs/nullableInteger" },
        "damageFormula": { "$ref": "#/$defs/nullableString" },
        "damageType": { "$ref": "#/$defs/nullableString" }
      },
      "additionalProperties": false
    },
    "resource": {
      "type": "object",
      "required": ["id", "name", "maximum", "initialValue", "rechargePeriod"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "maximum": { "type": "integer", "minimum": 1 },
        "initialValue": { "type": "integer", "minimum": 0 },
        "rechargePeriod": { "enum": ["shortRest", "longRest", "manual"] }
      },
      "additionalProperties": false
    },
    "feature": {
      "type": "object",
      "required": ["id", "name", "summary"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "rollModifier": { "$ref": "#/$defs/nullableInteger" }
      },
      "additionalProperties": false
    },
    "item": {
      "type": "object",
      "required": ["name", "quantity", "weightPerItem", "category"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "quantity": { "type": "integer", "minimum": 0 },
        "weightPerItem": { "type": "number", "minimum": 0 },
        "category": { "enum": ["consumable", "equipment", "tool", "quest", "general"] }
      },
      "additionalProperties": false
    }
  }
}
